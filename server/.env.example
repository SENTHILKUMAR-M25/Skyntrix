# ===== App =====
NODE_ENV=development
PORT=5000
# BASE_URL is the canonical public origin used to build links to generated files
# (quotation PDFs). Production: the app's public domain (https://api.skyntrix.com).
# Development: point it at a public tunnel so WhatsApp can download the PDF, e.g.
#   BASE_URL=https://<your-tunnel>.ngrok-free.app        (ngrok)
#   BASE_URL=https://<your-tunnel>.trycloudflare.com     (Cloudflare Tunnel)
# Leave blank to keep using UPLOADS_URL.
BASE_URL=
APP_URL=http://localhost:5173
UPLOADS_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
# Production (deployed): APP_URL=https://skyntrix.vercel.app, CLIENT_URL=https://skyntrix.vercel.app, ADMIN_URL=https://skyntrix.vercel.app
API_PREFIX=/api

# ===== Database =====
MONGODB_URI=mongodb://127.0.0.1:27017/skyntrix

# Quick Park (PostgreSQL + Prisma) - paste your Neon/Supabase connection string
DATABASE_URL=postgresql://user:password@host:5432/quickpark?sslmode=require

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change-me-refresh-secret-string
REFRESH_TOKEN_EXPIRES_IN=7d
JWT_COOKIE_NAME=skyntrix_at
REFRESH_COOKIE_NAME=skyntrix_rt

# ===== Quick Park JWT (User/Provider auth) =====
QUICKPARK_JWT_SECRET=change-me-quickpark-jwt-secret
QUICKPARK_JWT_EXPIRES_IN=1d
QUICKPARK_REFRESH_SECRET=change-me-quickpark-refresh-secret
QUICKPARK_REFRESH_EXPIRES_IN=7d
QUICKPARK_COOKIE_NAME=quickpark_at
QUICKPARK_REFRESH_COOKIE_NAME=quickpark_rt

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=skyntrix

# ===== Email (Nodemailer) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Skyntrix Technologies <no-reply@skyntrix.com>"

# ===== WhatsApp Business Cloud API =====
# Leave blank to fall back to opening WhatsApp Web (https://wa.me/...?text=...).
# With WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID set, "Send Quotation"
# is fully automatic:
#   - If the client has an open 24h customer-service window, the system sends
#     (1) a personalized TEXT message and (2) the PDF as a DOCUMENT attachment
#     (uploaded to Meta via the Media Upload API - no public URL required).
#   - If the window is closed, the system sends a pre-approved MESSAGE TEMPLATE
#     (WHATSAPP_QUOTATION_TEMPLATE_NAME) to initiate the conversation. When the
#     client replies, the webhook automatically sends the text + PDF follow-up.
# BASE_URL/UPLOADS_URL is used for the admin's PDF preview link and the wa.me
# fallback text; it is only embedded in a client message when it is a public
# HTTPS origin. A localhost URL is never sent to a client.
#
# Webhook (required for the no-session "template -> reply -> PDF" flow and for
# delivered/read status updates). Point Meta at:
#   <BASE_URL>/api/whatsapp/webhook
# and set the same WHATSAPP_WEBHOOK_VERIFY_TOKEN in the Meta dashboard. In
# development BASE_URL must be a public tunnel (ngrok / Cloudflare Tunnel).
# WHATSAPP_WEBHOOK_APP_SECRET optionally verifies x-hub-signature-256.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_WEBSITE=https://skyntrix.vercel.app/
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_APP_SECRET=
WHATSAPP_QUOTATION_TEMPLATE_NAME=skyntrix_quotation
WHATSAPP_QUOTATION_TEMPLATE_LANG=en
WHATSAPP_INVOICE_TEMPLATE_NAME=skyntrix_invoice
WHATSAPP_INVOICE_TEMPLATE_LANG=en
# Receipt uses the invoice template by default; create a dedicated one
# ({{1}} name, {{2}} receipt no, {{3}} project, {{4}} amount) and override here.
WHATSAPP_RECEIPT_TEMPLATE_NAME=skyntrix_invoice
WHATSAPP_RECEIPT_TEMPLATE_LANG=en

# ===== Security =====
CORS_ORIGINS=http://localhost:5173,https://skyntrix.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=50

# ===== Seed =====
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@skyntrix.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_ROLE=super-admin